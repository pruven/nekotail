---
import { Cat, Shuffle, Image, Volume2, CodeXml, ArrowRight, Heart, Download, X, Ellipsis } from '@lucide/astro';
import { device } from '../lib/cats';
import '../styles/global.css';
const identity = device(Astro);
const cat = identity.cat;
Astro.response.headers.set('Cache-Control', 'private, no-store');
Astro.response.headers.set('Vary', 'Cookie, X-Forwarded-For');
---
<!doctype html>
<html lang="en" data-type="software">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Cat pictures for your tailnet." />
    <meta name="page-type" content="software" /><meta name="site-kind" content="software" />
    <title>Nekotail</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <header class="toolbar">
      <a class="skip-link" href="#main">Skip to cat</a>
      <a class="brand icon-button" href="/" aria-label="Nekotail home" title="Nekotail"><Cat size={25} stroke-width={1.6}/></a>
      <div class="toolbar-actions">
        <div class="tabs" role="tablist" aria-label="Response type">
          <button class="icon-button" role="tab" aria-selected="true" aria-controls="cat-stage" id="tab-pictures" data-view="pictures" aria-label="Pictures" title="Pictures"><Image size={18}/></button>
          <button class="icon-button" role="tab" aria-selected="false" aria-controls="cat-stage" id="tab-meows" data-view="meows" aria-label="Meows" title="Meows"><Volume2 size={18}/></button>
          <button class="icon-button" role="tab" aria-selected="false" aria-controls="cat-stage" id="tab-status" data-view="status" aria-label="HTTP cats" title="HTTP cats"><CodeXml size={18}/></button>
        </div>
        <button class="icon-button" data-modal="menu" aria-label="More options" title="More options"><Ellipsis size={21}/></button>
      </div>
    </header>
    <main id="main" class="gallery">
      <h1 class="sr-only">Cat pictures</h1>
      <div class="cat-stage" id="cat-stage" role="tabpanel" aria-labelledby="tab-pictures" tabindex="0">
        <img id="cat-image" src={cat.image} alt={`${cat.name}, a ${cat.color.toLowerCase()} cat`} width="1400" height="1050" fetchpriority="high"/>
        <div class="image-actions">
          <button class="icon-button" id="favorite" aria-label="Favorite this cat" aria-pressed="false" title="Favorite"><Heart size={20}/></button>
          <button class="icon-button" id="download" aria-label="Download cat picture" title="Download"><Download size={20}/></button>
        </div>
        <div class="sound-overlay" id="sound-overlay" hidden><button id="play-meow" aria-label="Play a meow" title="Play a meow"><Volume2 size={44}/></button></div>
        <div class="status-overlay" id="status-overlay" hidden><strong id="status-code">200</strong><h2 id="status-title">OK</h2></div>
      </div>
      <div class="controls">
        <button class="primary-button" id="serve-cat"><span>Serve another cat</span><ArrowRight size={20}/></button>
        <button class="secondary-button" id="surprise"><Shuffle size={18}/><span>Surprise me</span></button>
      </div>
      <p id="inline-message" class="inline-message" role="alert"></p>
      <p id="announcement" class="sr-only" role="status" aria-live="polite"></p>
    </main>
    <dialog id="info-dialog" aria-labelledby="dialog-title"><div class="dialog-header"><h2 id="dialog-title">Nekotail</h2><button class="icon-button" id="close-dialog" aria-label="Close dialog"><X size={20}/></button></div><div id="dialog-content"></div></dialog>
    <audio id="meow-audio" preload="none"></audio>
    <script define:vars={{ assignedCat: cat, deviceId: identity.id }}>window.nekotail = { assignedCat, deviceId };</script>
    <script src="../lib/playground.ts"></script>
  </body>
</html>
